 bool AccountSetupFromCommandLineJob::handleAccountSetupFromCommandLine()
 {
+#if defined(APPLICATION_SERVER_URL_ENFORCE) && defined(APPLICATION_SERVER_URL)
+    // Branded build with an enforced server: --serverurl may only name that server.
+    const auto enforcedServerUrl = QUrl(QString::fromUtf8(APPLICATION_SERVER_URL)).adjusted(QUrl::StripTrailingSlash);
+    if (_serverUrl.adjusted(QUrl::StripTrailingSlash) != enforcedServerUrl) {
+        printAccountSetupFromCommandLineStatusAndExit(
+            QStringLiteral("This client only connects to %1.").arg(enforcedServerUrl.toString()), true);
+        return false;
+    }
+#endif
     if (AccountManager::instance()->accountFromUserId(QStringLiteral("%1@%2").arg(_userId, _serverUrl.host()))) {
         printAccountSetupFromCommandLineStatusAndExit(QStringLiteral("Account %1 already exists!").arg(QDir::toNativeSeparators(_userId)), true);
         return false;
